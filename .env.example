# ── Local Postgres (source of truth), exposed by docker compose ──────────────
# Async URL used by FastAPI (asyncpg driver); Alembic derives its sync URL from it.
# Defaults to the docker-compose Postgres, so leave as-is for local dev.
DATABASE_URL=postgresql+asyncpg://otter:otter@localhost:54321/otter

# ── Electric sync service (shape API) ────────────────────────────────────────
ELECTRIC_URL=http://localhost:3000

# ── FastAPI ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite build-time) ───────────────────────────────────────────────
VITE_ELECTRIC_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# ── Google (Tasks import + Gmail/Calendar scan) — fill when setting up OAuth ──
# Google Cloud Console → APIs & Services:
#   1. Enable "Google Tasks API", "Gmail API", and "Google Calendar API"
#   2. OAuth consent screen → External → add yourself as a test user
#      → add scopes: tasks, gmail.readonly, calendar.readonly
#   3. Credentials → OAuth client ID → Web application
#      → Authorized redirect URI = the GOOGLE_REDIRECT_URI below
#   4. Paste the client id + secret here, then restart the backend.
# (Gmail + Calendar read-only power task suggestions; if you connected before
#  those scopes existed, use "Reconnect" in Settings to re-consent.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback
# Where the browser is sent back after OAuth (the frontend).
APP_URL=http://localhost:5173
# Background reconcile interval in seconds (0 = manual "Sync now" only).
GOOGLE_SYNC_INTERVAL_SECONDS=300

# ── Task suggestions — Databricks FMAPI (the LLM intelligence) ───────────────
# The suggestion engine calls the workspace AI Gateway (OpenAI Responses API).
# By default the bearer token is minted on demand from your Databricks CLI login
# for DATABRICKS_HOST (`databricks auth token --host …`), so there's nothing to
# paste — just `databricks auth login` to that workspace once.
# e.g. https://<your-workspace>.cloud.databricks.com
DATABRICKS_HOST=
# Optional: force a specific CLI profile instead of resolving by host.
DATABRICKS_PROFILE=
# Optional: a static token (PAT) for headless/prod; blank → use the CLI login.
DATABRICKS_TOKEN=
# FMAPI serving model for suggestions.
LLM_MODEL=system.ai.gpt-5-6-sol
# Background scan interval in seconds (0 = manual "Scan now" only).
SUGGEST_SCAN_INTERVAL_SECONDS=900
SUGGEST_CALENDAR_LOOKAHEAD_DAYS=7
SUGGEST_EMAIL_LOOKBACK_DAYS=3

# ── Agentic quick-capture ────────────────────────────────────────────────────
# After a capture lands, an agent infers its area/project from your areas and
# how you've filed existing tasks. It auto-files when confidence ≥ the threshold;
# below it the task stays unfiled and a pre-filled filing suggestion goes to the
# inbox to refine. Captures are saved BEFORE this runs, so they're never lost.
CAPTURE_AGENT_ENABLED=true
CAPTURE_FILE_CONFIDENCE=0.7

# ── MLflow tracing (Databricks) — optional ───────────────────────────────────
# Traces the capture agent's LLM calls. OFF until you name an experiment — by
# path (MLFLOW_EXPERIMENT) or by id (MLFLOW_EXPERIMENT_ID, from the experiment's
# "connect" snippet). Auth reuses DATABRICKS_HOST + DATABRICKS_TOKEN (above) when
# tracking_uri is "databricks". Requires the deps:
#   cd backend && uv sync   (installs openai + mlflow-skinny)
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
# Set ONE of these (id wins if both are set):
MLFLOW_EXPERIMENT=
MLFLOW_EXPERIMENT_ID=
# e.g. MLFLOW_EXPERIMENT=/Users/you@example.com/otter-capture
# or   MLFLOW_EXPERIMENT_ID=4210894291236552

# ── Slack suggestions — via the Databricks-hosted Slack MCP ──────────────────
# Scans your Slack mentions + DMs for actionable tasks. No Slack app needed — it
# reuses the same Databricks CLI login as FMAPI above (bearer minted on demand).
# Blank SLACK_MCP_URL disables the Slack source.
# e.g. https://<your-workspace>.cloud.databricks.com/ai-gateway/mcp-services/system.ai.slack?o=<workspace-id>
SLACK_MCP_URL=
SUGGEST_SLACK_LOOKBACK_DAYS=3

# ── Genie (Databricks-hosted Genie One MCP) — natural-language Q&A tool ──────
# system.ai.genie_one_mcp is governed metastore-wide by Unity Catalog — there's
# no Genie "space" to configure, just a workspace. This is a *different*
# workspace than DATABRICKS_HOST above, so it mints its own CLI-login token
# (see genie_client.py) — `databricks auth login -p <profile>` once.
# e.g. https://adb-<id>.<n>.azuredatabricks.net
GENIE_HOST=
GENIE_PROFILE=
# The "o=" workspace id appended to the MCP endpoint URL.
GENIE_ORG_ID=
# Optional: a static token (PAT) for headless/prod; blank → use the CLI login.
GENIE_TOKEN=

# ── Backups (authoritative Postgres → local archive folder) ──────────────────
# The app writes a timestamped, gzipped JSON snapshot of every app table to
# BACKUP_DIR. Point Google Drive for Desktop (or rclone) at that folder to sync
# the archives off-machine — the app does NOT talk to Drive itself. OAuth tokens
# are excluded from archives (reconnect Google after a restore). Default is
# repo-root/backups; set it to your Drive-synced folder to protect your data.
BACKUP_DIR=../backups
# Scheduled backup interval in seconds (0 = manual "Back up now" only).
BACKUP_INTERVAL_SECONDS=86400
# Keep this many newest archives; older ones are pruned.
BACKUP_KEEP=14

# ── Dev scripts ───────────────────────────────────────────────────────────────
# Databricks CLI profiles that scripts/db-auth.sh and scripts/dev.sh check for a
# lapsed login (space-separated). Leave blank to skip.
OTTER_DB_PROFILES=
